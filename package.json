{
  "name": "zenox",
  "version": "2.0.1",
  "description": "OpenCode V2 plugin with specialized agents (explorer, librarian, oracle, ui-planner, inspector), a verification loop, hardened background tasks, and smart orchestration",
  "author": "Ayush",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zenox": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/tui.ts --outdir dist --target node --format esm --packages external && bun build src/cli/index.ts --outdir dist/cli --target node --format esm && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "zenox",
    "opencode",
    "plugin",
    "agents",
    "explorer",
    "librarian",
    "oracle",
    "ui-planner",
    "inspector",
    "verification",
    "background-tasks",
    "parallel",
    "orchestration",
    "ultrawork",
    "blueprint",
    "keyword-triggers",
    "toast-notifications",
    "todo-enforcer",
    "project-guidelines",
    "auto-documentation",
    "ai",
    "llm",
    "cli",
    "opencode-v2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CYBERBOYAYUSH/zenox.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@opencode/plugin": "^2.0.27",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.27",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "bun-types": "latest",
    "solid-js": "1.9.15",
    "typescript": "^5.7.3"
  },
  "engines": {
    "opencode": ">=2.0.0"
  }
}
