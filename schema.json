{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZenoxConfig",
  "description": "Configuration schema for zenox plugin",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor autocompletion"
    },
    "agents": {
      "type": "object",
      "description": "Override models for specific agents",
      "properties": {
        "explorer": {
          "$ref": "#/$defs/agentOverride",
          "description": "Fast codebase search specialist (default: anthropic/claude-haiku-4-5)"
        },
        "librarian": {
          "$ref": "#/$defs/agentOverride",
          "description": "Open-source research agent (default: anthropic/claude-sonnet-4-6)"
        },
        "oracle": {
          "$ref": "#/$defs/agentOverride",
          "description": "Strategic technical advisor (default: openai/gpt-5.5, variant medium)"
        },
        "ui-planner": {
          "$ref": "#/$defs/agentOverride",
          "description": "Designer-turned-developer for UI/UX (default: google/gemini-3-pro-high)"
        }
      },
      "additionalProperties": false
    },
    "disabled_agents": {
      "type": "array",
      "description": "List of agents to disable",
      "items": {
        "type": "string",
        "enum": ["explorer", "librarian", "oracle", "ui-planner"]
      },
      "uniqueItems": true
    },
    "disabled_mcps": {
      "type": "array",
      "description": "List of MCP servers to not auto-inject",
      "items": {
        "type": "string",
        "enum": ["exa", "grep_app", "sequential-thinking"]
      },
      "uniqueItems": true
    },
    "disabled_skills": {
      "type": "array",
      "description": "List of bundled skills to NOT auto-install/sync (e.g. 'frontend-design', 'grill-me')",
      "items": {
        "type": "string",
        "enum": ["frontend-design", "grill-me"]
      },
      "uniqueItems": true
    },
    "auto_update": {
      "type": "object",
      "description": "Auto-update behavior",
      "properties": {
        "show_startup_toast": {
          "type": "boolean",
          "description": "Show the startup version toast on session start (default: true)",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "description": "Background task concurrency limits (guards against runaway parallel fan-out)",
      "properties": {
        "max_concurrent": {
          "type": "integer",
          "description": "Max simultaneously running background tasks (default: 6)",
          "minimum": 1,
          "maximum": 50,
          "default": 6
        },
        "max_per_session": {
          "type": "integer",
          "description": "Max total background tasks a single session may spawn; lifetime circuit breaker (default: 50)",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "agentOverride": {
      "type": "object",
      "description": "Agent override configuration",
      "properties": {
        "model": {
          "type": "string",
          "description": "Model identifier (e.g., 'anthropic/claude-sonnet-4', 'openai/gpt-4o')"
        },
        "variant": {
          "type": "string",
          "description": "Thinking/reasoning mode variant (e.g., 'high', 'xhigh', 'max'). Applied to messages for models that support extended thinking.",
          "examples": ["low", "medium", "high", "xhigh", "max"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
